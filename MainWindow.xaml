<Window
    x:Class="ColorTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ColorTool"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="myWindow"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="30"
            CornerRadius="0"
            GlassFrameThickness="-1"
            ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="45" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="CloseButtonStyle"
            BasedOn="{StaticResource CaptionButtonStyle}"
            TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0" Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1A1A1A">
            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#AAAAAA"
                Text="質感配色工具" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                <Button Click="MinimizeButton_Click" Style="{StaticResource CaptionButtonStyle}">
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0,0 L 10,0"
                        Stroke="#AAAAAA"
                        StrokeThickness="1.5" />
                </Button>

                <Button Click="MaximizeButton_Click" Style="{StaticResource CaptionButtonStyle}">
                    <Path
                        Fill="Transparent"
                        Stroke="#AAAAAA"
                        StrokeThickness="1.5">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 0,0 L 10,0 L 10,10 L 0,10 Z" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, ElementName=myWindow}" Value="Maximized">
                                        <Setter Property="Data" Value="M 2,0 L 10,0 L 10,8 L 8,8 L 8,10 L 0,10 L 0,2 L 2,2 Z M 2,2 L 8,2 L 8,8 L 2,8 Z" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <Button Click="CloseButton_Click" Style="{StaticResource CloseButtonStyle}">
                    <Path
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0,0 L 10,10 M 0,10 L 10,0"
                        Stroke="#AAAAAA"
                        StrokeThickness="1.5" />
                </Button>

            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="#AAAAAA"
                        Text="HSL (三角形)" />
                    <Grid Width="180" Height="180">
                        <Image
                            x:Name="HueRingImage_HSL"
                            Cursor="Cross"
                            MouseLeftButtonDown="HueRing_Mouse"
                            MouseMove="HueRing_Mouse"
                            RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas IsHitTestVisible="False">
                            <Ellipse
                                x:Name="HueSelector_HSL"
                                Width="14"
                                Height="14"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeThickness="2.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="HueSelectorTransform_HSL" X="0" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>

                        <Grid
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Image
                                x:Name="InnerShapeImage_HSL"
                                Cursor="Cross"
                                MouseLeftButtonDown="Triangle_Mouse"
                                MouseMove="Triangle_Mouse"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas IsHitTestVisible="False">
                                <Ellipse
                                    x:Name="SlSelector_HSL"
                                    Width="10"
                                    Height="10"
                                    Fill="White"
                                    Stroke="Black"
                                    StrokeThickness="1.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="SlSelectorTransform_HSL" X="60" Y="60" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,20,0"
                    HorizontalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="#AAAAAA"
                        Text="HSV (方形)" />
                    <Grid Width="180" Height="180">
                        <Image
                            x:Name="HueRingImage_HSV"
                            Cursor="Cross"
                            MouseLeftButtonDown="HueRing_Mouse"
                            MouseMove="HueRing_Mouse"
                            RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas IsHitTestVisible="False">
                            <Ellipse
                                x:Name="HueSelector_HSV"
                                Width="14"
                                Height="14"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeThickness="2.5">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="HueSelectorTransform_HSV" X="0" Y="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>

                        <Grid
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Image
                                x:Name="InnerShapeImage_HSV"
                                Cursor="Cross"
                                MouseLeftButtonDown="Square_Mouse"
                                MouseMove="Square_Mouse"
                                RenderOptions.BitmapScalingMode="HighQuality" />
                            <Canvas IsHitTestVisible="False">
                                <Ellipse
                                    x:Name="SlSelector_HSV"
                                    Width="10"
                                    Height="10"
                                    Fill="White"
                                    Stroke="Black"
                                    StrokeThickness="1.5">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="SlSelectorTransform_HSV" X="60" Y="60" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Grid>
                </StackPanel>

                <Border
                    x:Name="ColorDisplay"
                    Grid.Column="2"
                    Background="Black"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="10" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Button
                    x:Name="ModeToggleButton"
                    Width="250"
                    Height="30"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left"
                    Background="#2D2D30"
                    BorderBrush="#3E3E42"
                    BorderThickness="1"
                    Click="ModeToggleButton_Click"
                    Content="目前的滑桿屬性：HSL (點擊切換為 HSV)"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="#4EC9B0" />

                <TextBlock
                    Margin="0,5,0,5"
                    FontWeight="Bold"
                    Foreground="#4EC9B0"
                    Text="色相 (H) - 顏色種類" />
                <Slider
                    x:Name="H_Slider"
                    Background="#333333"
                    Foreground="#555555"
                    IsSnapToTickEnabled="True"
                    Maximum="360"
                    Minimum="0"
                    Opacity="0.8"
                    TickFrequency="1"
                    ValueChanged="HlsSlider_ValueChanged"
                    Value="0" />
                <TextBlock
                    x:Name="H_ValueText"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Right"
                    Foreground="#888888"
                    Text="0°" />

                <TextBlock
                    x:Name="L_Label"
                    Margin="0,5,0,5"
                    FontWeight="Bold"
                    Foreground="#CE9178"
                    Text="亮度 (L) - 明暗程度" />
                <Slider
                    x:Name="L_Slider"
                    Background="#333333"
                    Foreground="#555555"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Opacity="0.8"
                    TickFrequency="1"
                    ValueChanged="HlsSlider_ValueChanged"
                    Value="50" />
                <TextBlock
                    x:Name="L_ValueText"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Right"
                    Foreground="#888888"
                    Text="50%" />

                <TextBlock
                    x:Name="S_Label"
                    Margin="0,5,0,5"
                    FontWeight="Bold"
                    Foreground="#D16969"
                    Text="飽和度 (S) [HLS] - 鮮豔程度" />
                <Slider
                    x:Name="S_Slider"
                    Background="#333333"
                    Foreground="#555555"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="0"
                    Opacity="0.8"
                    TickFrequency="1"
                    ValueChanged="HlsSlider_ValueChanged"
                    Value="100" />
                <TextBlock
                    x:Name="S_ValueText"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Right"
                    Foreground="#888888"
                    Text="100%" />
            </StackPanel>

            <UniformGrid
                Grid.Row="2"
                Columns="2"
                Rows="2">
                <TextBlock
                    x:Name="RgbText"
                    Margin="5"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="#DDDDDD"
                    Text="RGB: 0, 0, 0" />
                <TextBlock
                    x:Name="CmykText"
                    Margin="5"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="#DDDDDD"
                    Text="CMYK: 0%, 0%, 0%, 100%" />
                <TextBlock
                    x:Name="HsvText"
                    Margin="5"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="#DDDDDD"
                    Text="HSV: 0°, 0%, 0%" />
                <TextBlock
                    x:Name="HlsText"
                    Margin="5"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="#DDDDDD"
                    Text="HLS: 0°, 50%, 100%" />
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
